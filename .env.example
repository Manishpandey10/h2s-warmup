# Public Supabase project connection details. RLS protects user records.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://h2s-warmup.vercel.app

# Leave empty for one-service hosting. Set to the backend origin for separate services.
NEXT_PUBLIC_API_BASE_URL=

# Server only. Never put your API key in a NEXT_PUBLIC_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Separate backend only: exact frontend origin, without trailing slash.
FRONTEND_ORIGIN=http://localhost:3000

# Optional: a real RESTRICTED source editor account created manually in Supabase.
# These values are intentionally displayed publicly on /admin/login.
# Never use credentials for your Supabase dashboard or any privileged account.
ADMIN_TEST_EMAIL=
ADMIN_TEST_PASSWORD=
